# Copy to .env and adjust. `task up` fills LAN_IP automatically.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=debug

# --- LAN address -----------------------------------------------------------
# Set by `task lan-ip` / `task up`. A physical device cannot resolve `localhost`
# or the docker service name `localstack`, so anything the phone must reach has
# to be signed and served on this address. See S3_ENDPOINT_PUBLIC below.
LAN_IP=127.0.0.1

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=photu
POSTGRES_PASSWORD=photu
POSTGRES_DB=photu
# Host-side (migrations, psql, tests run outside compose):
DATABASE_URL=postgres://photu:photu@localhost:5432/photu?sslmode=disable

# --- S3 / LocalStack -------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Path-style addressing is mandatory whenever the endpoint is overridden:
# virtual-host style would resolve `photu-media-dev.localstack:4566`, which
# neither container DNS nor iOS will answer. Real AWS wants virtual-host style,
# so this flag is coupled to the endpoint override, never hardcoded true.
S3_USE_PATH_STYLE=true

# TWO endpoints, and the distinction is load-bearing.
# SigV4 signs the Host header, so a presigned URL's host CANNOT be rewritten
# after signing. The API therefore builds two S3 clients:
#   internal -> server-side calls (HeadObject, CompleteMultipartUpload, Delete)
#   public   -> used ONLY by the presigner, so the phone can reach the result.
# See docs/adr/0003-upload-protocol.md.
S3_ENDPOINT_INTERNAL=http://localhost:4566
S3_ENDPOINT_PUBLIC=http://${LAN_IP}:4566

MEDIA_BUCKET=photu-media-dev
# Face data lives in its own bucket so it can have its own KMS key, its own
# retention rule, and a `delete my face data` that is a provable prefix delete.
FACEDATA_BUCKET=photu-facedata-dev

# --- API -------------------------------------------------------------------
API_PORT=8080
PUBLIC_BASE_URL=http://${LAN_IP}:8080

# Ed25519 keypair for access tokens. Generate with `task keys:dev`.
# NEVER commit real values; .env is gitignored.
JWT_PRIVATE_KEY_PEM=
JWT_KEY_ID=dev-1
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=90d

# --- Identity providers ----------------------------------------------------
APPLE_BUNDLE_ID=app.photu.mobile
APPLE_SERVICE_ID=app.photu.web
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# --- Pluggable ports (fake implementations in local dev) -------------------
SMS_PROVIDER=fake
PUSH_PROVIDER=fake
RECEIPT_VERIFIER=fake

# --- Faces -----------------------------------------------------------------
FACE_MODEL_ID=insightface:buffalo_l:1
# Thresholds live in config, never in code: published ArcFace numbers do not
# transfer across checkpoints, image quality, or demographics.
FACE_MATCH_THRESHOLD=0.62
FACE_WEAK_THRESHOLD=0.45
ORT_NUM_THREADS=2

# --- Product limits --------------------------------------------------------
FREE_ALBUM_SLOTS=3
MAX_ALBUM_MEMBERS=30
MAX_VIDEO_DURATION_MS=60000
MULTIPART_THRESHOLD_BYTES=16777216
MULTIPART_PART_SIZE_BYTES=8388608
