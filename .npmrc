# node-linker=hoisted is REQUIRED and must be set before the first `pnpm install`.
#
# pnpm's default symlinked store is the single largest source of failures in an
# Expo bare/prebuild monorepo: Metro's resolver walks real paths, Gradle
# autolinking resolves module paths from settings.gradle, and CocoaPods resolves
# relative Podfile paths — all three break on symlinks. `hoisted` gives an
# npm-flat node_modules with pnpm's lockfile and install speed.
#
# See docs/adr/0001-monorepo-tooling.md. Do not change this without reading it.
node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false

# Expo/RN packages routinely need to run install scripts.
enable-pre-post-scripts=true

# Pin the Node version pnpm uses for installs and scripts, so it does not depend
# on whatever the developer's shell happens to have activated.
#
# This is not cosmetic. Several toolchain packages ship platform-specific native
# binaries as OPTIONAL dependencies constrained by `engines`, e.g. rolldown (via
# vitest) requires `^20.19.0 || >=22.12.0`. On Node 22.3.0 pnpm correctly skips
# the binding as unsatisfiable and the failure surfaces much later as
# "Cannot find module './rolldown-binding.darwin-arm64.node'" — which looks like a
# broken install rather than a Node version problem. `pnpm install --force`
# appears to fix it by bypassing the engine check, then a normal install prunes
# the binding again.
#
# Keep in sync with .nvmrc and the `engines` field in package.json.
use-node-version=22.23.1
